<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>ms365sync</id>
    <name>Microsoft 365 Sync</name>
    <summary>Sync OneDrive and SharePoint into Nextcloud</summary>
    <description><![CDATA[Sync OneDrive and SharePoint document libraries into Nextcloud via rclone. Packaged as a Nextcloud External App (AppAPI).]]></description>
    <version>1.0.11</version>
    <licence>agpl</licence>
    <author>sib.io</author>
    <namespace>MS365Sync</namespace>
    <category>integration</category>
    <bugs>https://github.com/Haraldooo/nextcloud_app_ms365sync/issues</bugs>
    <repository type="git">https://github.com/Haraldooo/nextcloud_app_ms365sync.git</repository>
    <dependencies>
        <nextcloud min-version="29" max-version="34"/>
    </dependencies>
    <external-app>
        <docker-install>
            <registry>ghcr.io</registry>
            <image>haraldooo/ms365sync-exapp</image>
            <image-tag>1.0.11</image-tag>
        </docker-install>
        <scopes>
            <value>FILES</value>
            <value>USER_INFO</value>
            <value>BACKGROUND_JOB</value>
        </scopes>
        <routes>
            <route>
                <url>api\/v1\/.*</url>
                <verb>GET,POST,PUT,DELETE</verb>
                <access_level>ADMIN</access_level>
            </route>
            <route>
                <url>js\/.*</url>
                <verb>GET</verb>
                <access_level>ADMIN</access_level>
            </route>
            <route>
                <url>css\/.*</url>
                <verb>GET</verb>
                <access_level>ADMIN</access_level>
            </route>
        </routes>
    </external-app>
</info>
